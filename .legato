audio {
    sine { freq: 440.0, chans: 1},
    adsr { attack: 30.0, decay: 40.0, sustain: 0.0, release: 30.0, chans: 1 },
    mono_fan_out { chans: 2 }
}

control {
    clock { bpm: 120, division: 4, steps: 64 },
    sequencer { num_steps: 64 }
}

clock >> sequencer

sequencer.gate >> adsr.gate
sine >> adsr[1]

sequencer.freq >> sine

adsr >> mono_fan_out

{ mono_fan_out }